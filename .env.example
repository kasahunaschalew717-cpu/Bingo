# Server Environment Configuration
PORT=3001
NODE_ENV=production

# Ardi Game Zone Desk Backend URL (from Extra Games page, no trailing slash)
ARDI_API_URL=https://your-ardi-backend.example

# Secret Game Key assigned by Ardi Desk (agk_...) - NEVER commit real key
ARDI_GAME_KEY=agk_replace_with_your_real_game_key

# Set to 'true' ONLY for local offline sandbox testing without a live Ardi desk
USE_MOCK_WALLET=false

# Game Economics & Timing
RAKE_PERCENT=0.10
MIN_PLAYERS_TO_START=2
COUNTDOWN_SECONDS=120
BALL_INTERVAL_MS=3000
INTERMISSION_MS=8000

# SQLite Ledger Database Path
DB_PATH=./server/data/bingo.db

# CORS Allowed Origin (set to your domain or Telegram mini-app origin in production)
ALLOWED_ORIGIN=*
